{
  "permissions": {
    "allow": [
      "Bash(npx playwright test *)",
      "Bash(npx playwright show-report)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if grep -rn 'waitForTimeout' tests pages; then echo 'waitForTimeout is forbidden, use web-first assertions' >&2; exit 2; fi"
          }
        ]
      }
    ]
  }
}